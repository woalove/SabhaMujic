<UserControl x:Class="SabhaMujic.Desktop.Views.Admin.CategoriesAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="New category" Style="{StaticResource AccentButton}" Command="{Binding CreateCommand}" Margin="0,0,8,6" />
            <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,0,8,6" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,16,6" />
            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Command="{Binding MoveUpCommand}" ToolTip="Move up" AutomationProperties.Name="Move up" />
            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Command="{Binding MoveDownCommand}" ToolTip="Move down" AutomationProperties.Name="Move down" />
        </WrapPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />
        <TextBlock DockPanel.Dock="Bottom" FontSize="12" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                   Text="The order here is the order in the sidebar. Deleting a category keeps its tracks (they become uncategorized)." TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MaxWidth="560" HorizontalAlignment="Left"
                 MinWidth="360" AutomationProperties.Name="Categories">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding TrackCount, StringFormat='{}{0} tracks'}" />
                        <TextBlock Text="{Binding Name}" FontSize="16" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
