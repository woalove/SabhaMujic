<UserControl x:Class="SabhaMujic.Desktop.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="Welcome to SabhaMujic" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Create the first administrator account. Administrators add music and create accounts for volunteers." />

                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <TextBlock Text="Administrator name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AdminNameBox" Text="{Binding AdminName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Administrator name" />

                <TextBlock Text="PIN or password (at least 4 characters)" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="SecretBox" PasswordChanged="OnSecretChanged" AutomationProperties.Name="PIN or password" />

                <TextBlock Text="Repeat PIN or password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnConfirmChanged" AutomationProperties.Name="Repeat PIN or password" />

                <TextBlock Text="{Binding ValidationHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ValidationHint, Converter={StaticResource NullToVisibility}}" />

                <Button Content="Create administrator" Style="{StaticResource AccentButton}" IsDefault="True" Margin="0,18,0,0"
                        HorizontalAlignment="Stretch" MinHeight="44" FontSize="16" Command="{Binding CompleteSetupCommand}" />

                <TextBlock Text="Waiting for the SabhaMujic service…" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
