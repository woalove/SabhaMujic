<UserControl x:Class="SabhaMujic.Desktop.Views.NowPlayingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Play/pause glyph follows IsPlaying. -->
        <Style x:Key="PlayPauseGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE768;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Text" Value="&#xE769;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MuteGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE767;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter Property="Text" Value="&#xE74F;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PlayerBackgroundBrush}" Padding="16,10" TextElement.Foreground="{StaticResource PlayerTextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Track info -->
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Now playing" />
                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource PlayerMutedTextBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Artist, Converter={StaticResource NullToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                            Visibility="{Binding IsCrossfading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Crossfading" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource PlayerMutedTextBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding NextTitle, StringFormat='Up next: {0}'}" FontSize="12" Foreground="{StaticResource PlayerMutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NextTitle, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding PlaybackError}" Foreground="#FCA5A5" TextWrapping="Wrap" FontWeight="SemiBold"
                           Visibility="{Binding HasPlaybackError, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="{StaticResource PlayerTextBrush}"
                            Command="{Binding DismissMessageCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PlayerMutedTextBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Transport -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Command="{Binding PreviousCommand}"
                        ToolTip="Previous (Ctrl+←)" AutomationProperties.Name="Previous" />
                <Button Style="{StaticResource TransportButton}" Content="&#xE71A;" Command="{Binding StopCommand}"
                        ToolTip="Stop" AutomationProperties.Name="Stop" />
                <Button Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}"
                        ToolTip="Play / pause (Space)" AutomationProperties.Name="{Binding PlayPauseText}">
                    <TextBlock Style="{StaticResource PlayPauseGlyph}" />
                </Button>
                <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Command="{Binding NextCommand}"
                        ToolTip="Next (Ctrl+→)" AutomationProperties.Name="Next" />
            </StackPanel>

            <!-- Volume -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}" Width="40" Height="40" FontSize="16" Command="{Binding ToggleMuteCommand}"
                        ToolTip="Mute / unmute" AutomationProperties.Name="Mute">
                    <TextBlock Style="{StaticResource MuteGlyph}" />
                </Button>
                <Slider Style="{StaticResource PlayerSlider}" Width="120" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding Volume}" ToolTip="Volume" AutomationProperties.Name="Volume" />
            </StackPanel>

            <!-- Seek + loop + crossfade + mini player -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PositionText}" MinWidth="48" VerticalAlignment="Center" />
                <Slider Grid.Column="1" x:Name="SeekSlider" Style="{StaticResource PlayerSlider}" Margin="6,0"
                        Minimum="0" Maximum="{Binding Duration}" Value="{Binding SliderPosition}" IsEnabled="{Binding HasTrack}"
                        AutomationProperties.Name="Seek" ToolTip="Drag to seek" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" MinWidth="48" VerticalAlignment="Center" TextAlignment="Right" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlayerTextButton}" Command="{Binding CycleLoopModeCommand}" MinWidth="130"
                            ToolTip="Loop mode: Off → Smart Loop → Repeat queue" AutomationProperties.Name="Loop mode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LoopModeText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Crossfade" VerticalAlignment="Center" Foreground="{StaticResource PlayerMutedTextBrush}" Margin="4,0,6,0" />
                    <Slider Style="{StaticResource PlayerSlider}" Width="90" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding CrossfadeSeconds}" AutomationProperties.Name="Crossfade seconds" ToolTip="Crossfade between tracks (0–12 s)" />
                    <TextBlock Text="{Binding CrossfadeSeconds, StringFormat='{}{0:0} s'}" MinWidth="34" VerticalAlignment="Center" Margin="6,0,8,0" />
                    <Button Style="{StaticResource TransportButton}" Width="40" Height="40" FontSize="16" Content="&#xE73F;"
                            Click="OnMiniPlayerClick" ToolTip="Mini player" AutomationProperties.Name="Mini player" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
