<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the whole service (SabhaHost) as a console app with a silent real-time output, for development and e2e tests.
       net10.0 runs anywhere (WAV decoder); net10.0-windows adds Media Foundation decoding (MP3/M4A/WMA/FLAC).
       See Program.cs for the command line. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <AssemblyName>SabhaMujic.DevHost</AssemblyName>
    <RootNamespace>SabhaMujic.DevHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SabhaMujic.Server/SabhaMujic.Server.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="../../src/SabhaMujic.Audio.Windows/SabhaMujic.Audio.Windows.csproj" />
  </ItemGroup>
</Project>
