<UserControl x:Class="SabhaMujic.Desktop.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels;assembly=SabhaMujic.Desktop.ViewModels">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Margin="0"
                    ToolTip="Remove everything except the track playing now" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />
        <TextBlock DockPanel.Dock="Bottom" Text="Drag to reorder · double-click to play" FontSize="12"
                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />

        <ListBox x:Name="QueueList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 MouseDoubleClick="OnItemDoubleClick" AutomationProperties.Name="Queue">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="{StaticResource CurrentItemBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                    <Border Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Number" Grid.Column="0" Text="{Binding Number}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NowGlyph" Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE768;"
                                       Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" ToolTip="Current track" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Style="{StaticResource MutedText}">
                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                    <Run Text="{Binding Artist, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play this"
                                        Command="{Binding Owner.PlayItemCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Play this" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up"
                                        Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Move up" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down"
                                        Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Move down" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from queue"
                                        Command="{Binding Owner.RemoveCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Remove from queue" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NowGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
