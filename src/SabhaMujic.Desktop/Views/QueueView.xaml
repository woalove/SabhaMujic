<UserControl x:Class="SabhaMujic.Desktop.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels;assembly=SabhaMujic.Desktop.ViewModels">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" Margin="0"
                    ToolTip="Remove everything except the track playing now" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />
        <TextBlock DockPanel.Dock="Bottom" Text="Drag to reorder · double-click to play" FontSize="12"
                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />

        <ListBox x:Name="QueueList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 MouseDoubleClick="OnItemDoubleClick" AutomationProperties.Name="Queue"
                 ItemContainerStyle="{StaticResource TimelineItem}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Style="{StaticResource TimelineRule}" />
                        <Ellipse Grid.Column="0" Style="{StaticResource TimelineNode}" Margin="0,31,0,0" ToolTip="{Binding Number}" />

                        <StackPanel Grid.Column="1" Margin="2,8,8,10">
                            <TextBlock Style="{StaticResource MetaText}" FontSize="13">
                                <Run Text="{Binding Number, Mode=OneWay, StringFormat='#{0}'}" /><Run Text=" · " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TimelineTitle}" FontSize="16" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource MetaText}"
                                       Visibility="{Binding Artist, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" FontSize="12" Content="&#xE768;"
                                        ToolTip="Play this" Command="{Binding Owner.PlayItemCommand}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="Play this" />
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" FontSize="12" Content="&#xE74D;"
                                        ToolTip="Remove from queue" Command="{Binding Owner.RemoveCommand}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="Remove from queue" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" FontSize="11" Content="&#xE70E;"
                                        ToolTip="Move up" Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="Move up" />
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" FontSize="11" Content="&#xE70D;"
                                        ToolTip="Move down" Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="Move down" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
