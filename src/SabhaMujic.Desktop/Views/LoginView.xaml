<UserControl x:Class="SabhaMujic.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="Admin sign-in" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Playing music needs no sign-in. Administrators sign in to manage the library, accounts and phones." />

                <Border Style="{StaticResource WarningBanner}" Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="User name" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="SecretBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Password" />

                <Button Content="Sign in" Style="{StaticResource AccentButton}" IsDefault="True" Margin="0,18,0,0"
                        HorizontalAlignment="Stretch" MinHeight="44" FontSize="16" Command="{Binding LoginCommand}" />
                <Button Content="Back" Margin="0,10,0,0" HorizontalAlignment="Stretch" MinHeight="40" IsCancel="True"
                        Command="{Binding CloseCommand}" />

                <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="14">
                    <Hyperlink Command="{Binding ForgotAdminPinCommand}" Foreground="{StaticResource AccentBrush}"
                               AutomationProperties.Name="Forgot admin password?"
                               AutomationProperties.HelpText="Reset an administrator password on this PC. Needs Windows administrator rights.">
                        <Run Text="Forgot admin password?" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="Waiting for the SabhaMujic service…" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
