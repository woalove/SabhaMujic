<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SabhaMujic.Core/SabhaMujic.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
  </ItemGroup>
  <ItemGroup>
    <!-- Versioned schema scripts: Migrations/NNNN_name.sql, applied in order by SqliteDatabase.MigrateAsync. -->
    <EmbeddedResource Include="Migrations/*.sql" LogicalName="SabhaMujic.Data.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SabhaMujic.Data.Tests" />
  </ItemGroup>
</Project>
