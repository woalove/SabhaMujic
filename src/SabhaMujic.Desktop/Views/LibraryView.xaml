<UserControl x:Class="SabhaMujic.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels;assembly=SabhaMujic.Desktop.ViewModels">
    <UserControl.Resources>
        <!-- One menu instance per row (x:Shared=False); its DataContext is the row's TrackItemViewModel. -->
        <ContextMenu x:Key="TrackMenu" x:Shared="False">
            <MenuItem Header="Play now" Command="{Binding Owner.PlayNowCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" />
            <MenuItem Header="Play next" Command="{Binding Owner.PlayNextCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Add to queue" Command="{Binding Owner.AddToQueueCommand}" CommandParameter="{Binding}" />
            <Separator />
            <!-- Sub-items are the playlists; their Click bubbles to OnAddToPlaylistClick (code-behind). -->
            <MenuItem Header="Add to playlist" ItemsSource="{Binding Owner.PlaylistTargets}" Click="OnAddToPlaylistClick">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Categories…" Command="{Binding Owner.EditCategoriesCommand}" CommandParameter="{Binding}"
                      Visibility="{Binding Owner.CanManageCategories, Converter={StaticResource BoolToVisibility}}" />
        </ContextMenu>

        <!-- Category tab menu (admin): choose the category's tracks. -->
        <ContextMenu x:Key="CategoryTabMenu" x:Shared="False">
            <MenuItem Header="Add tracks…" Click="OnAddTracksToCategoryClick" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Two-tone page title (category qualifier) + search -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Grid DockPanel.Dock="Right" Width="300" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,6,36,6"
                         AutomationProperties.Name="Search tracks" ToolTip="Search titles and artists (Ctrl+F)">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="13,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Text3Brush}" IsHitTestVisible="False" />
                <TextBlock Text="Search" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource Text3Brush}"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="30" Height="30" MinHeight="30"
                        HorizontalAlignment="Right" Margin="0,0,4,0"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear search" AutomationProperties.Name="Clear search"
                        Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}" />
            </Grid>
            <TextBlock FontSize="26" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="Library" Foreground="{DynamicResource TextBrush}" /><Run Text="{Binding SelectedCategory.Name, Mode=OneWay, StringFormat=' {0}'}" Foreground="{DynamicResource Text2Brush}" />
            </TextBlock>
        </DockPanel>

        <!-- Category tab row: "All" + each category with its coloured dot and track count -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,12">
            <ListBox x:Name="CategoryTabs" Style="{StaticResource TabRowList}" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="Categories"
                     PreviewMouseRightButtonDown="OnCategoryTabRightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource TagDot}" Margin="0,0,8,0"
                                     Visibility="{Binding HasDot, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding TrackCount}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="7,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />

        <!-- Track list: timeline rows -->
        <ListBox Grid.Row="3" x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                 MouseDoubleClick="OnTrackDoubleClick" AutomationProperties.Name="Tracks">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource TimelineItem}">
                    <Setter Property="ContextMenu" Value="{StaticResource TrackMenu}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrackItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Gutter: vertical rule + node (filled accent on the playing track) -->
                        <Rectangle Grid.Column="0" Style="{StaticResource TimelineRule}" />
                        <Ellipse Grid.Column="0" Style="{StaticResource TimelineNode}" Margin="0,37,0,0" />

                        <StackPanel Grid.Column="1" Margin="4,10,12,12">
                            <TextBlock Text="{Binding TopLine}" Style="{StaticResource MetaText}" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TimelineTitle}" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" FontSize="14" Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding AnalysisText}" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding Pills}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagPill}">
                                                <TextBlock Text="{Binding Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource NeutralPill}" Visibility="{Binding HasSmartLoop, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Smart Loop" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="Play" Padding="14,5" MinHeight="32"
                                    Command="{Binding Owner.PlayNowCommand}" CommandParameter="{Binding}"
                                    ToolTip="Play now" AutomationProperties.Name="Play now" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="Play next"
                                    Command="{Binding Owner.PlayNextCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Play next" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add to queue"
                                    Command="{Binding Owner.AddToQueueCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Add to queue" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8EC;" ToolTip="Categories…"
                                    Command="{Binding Owner.EditCategoriesCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Categories"
                                    Visibility="{Binding Owner.CanManageCategories, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" ToolTip="More"
                                    Click="OnMoreClick" AutomationProperties.Name="More actions" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" Text="No tracks match." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />

        <!-- Paging -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Command="{Binding PreviousPageCommand}"
                    ToolTip="Previous page" AutomationProperties.Name="Previous page" />
            <TextBlock Text="{Binding PageText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Command="{Binding NextPageCommand}"
                    ToolTip="Next page" AutomationProperties.Name="Next page" />
        </StackPanel>
    </Grid>
</UserControl>
