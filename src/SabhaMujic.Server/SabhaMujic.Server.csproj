<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SabhaMujic.Audio/SabhaMujic.Audio.csproj" />
    <ProjectReference Include="../SabhaMujic.Data/SabhaMujic.Data.csproj" />
    <!-- Shared JSON-RPC wire protocol (method naming, framing, error mapping) lives in Client. -->
    <ProjectReference Include="../SabhaMujic.Client/SabhaMujic.Client.csproj" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
  <ItemGroup>
    <!-- M5: the mobile web remote is served from memory (no build step at install time). See Remote/Http/WebAssets.cs. -->
    <EmbeddedResource Include="../SabhaMujic.Remote.Web/wwwroot/**/*" LogicalName="RemoteWeb/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SabhaMujic.Server.Tests" />
  </ItemGroup>
</Project>
