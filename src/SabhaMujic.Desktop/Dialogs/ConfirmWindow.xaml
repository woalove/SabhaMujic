<Window x:Class="SabhaMujic.Desktop.Dialogs.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" Width="440" WindowStartupLocation="CenterOwner">
    <StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" LineHeight="22" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="96" Margin="0" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
