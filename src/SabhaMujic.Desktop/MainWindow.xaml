<Window x:Class="SabhaMujic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels;assembly=SabhaMujic.Desktop.ViewModels"
        xmlns:admin="clr-namespace:SabhaMujic.Desktop.ViewModels.Admin;assembly=SabhaMujic.Desktop.ViewModels"
        xmlns:views="clr-namespace:SabhaMujic.Desktop.Views"
        Title="SabhaMujic" Height="720" Width="1180" MinHeight="480" MinWidth="760"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="15"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <!-- Centre content: one view per page view model. -->
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistsViewModel}">
            <views:PlaylistsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Queue" Style="{StaticResource PageTitle}" />
                <views:QueueView />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type admin:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Demo mode badge -->
        <Border Grid.Row="0" x:Name="DemoBanner" Visibility="Collapsed" Background="{StaticResource InfoBackgroundBrush}" Padding="12,6">
            <TextBlock Foreground="{StaticResource InfoTextBrush}" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="DEMO MODE" />
                <Run Text="— in-memory sample data, no audio, nothing is saved. Accounts: admin / 1234 (Admin), sevak / 1111 (Volunteer). Ctrl+Shift+R simulates a lost connection." />
            </TextBlock>
        </Border>

        <!-- Connection banner: Connecting / Reconnecting / Disconnected -->
        <Border Grid.Row="1" Padding="12,8"
                Visibility="{Binding IsConnectionBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningTextBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnectionProblem}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorTextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="18" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ConnectionBannerText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>

        <!-- Signed out: login -->
        <views:LoginView Grid.Row="2" DataContext="{Binding Login}"
                         Visibility="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

        <!-- Signed in: sidebar | content | queue panel -->
        <Grid Grid.Row="2" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: navigation + categories -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="10,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="SabhaMujic" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="6,0,0,10" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Library}"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Library}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F1;" Margin="0,0,10,0" />
                                <TextBlock Text="Library" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Playlists}"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Playlists}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE90B;" Margin="0,0,10,0" />
                                <TextBlock Text="Playlists" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Queue}"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Queue}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Margin="0,0,10,0" />
                                <TextBlock Text="Queue" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding IsAdminVisible, Converter={StaticResource BoolToVisibility}}"
                                     Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Admin}"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Admin}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,10,0" />
                                <TextBlock Text="Admin" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Command="{Binding ToggleQueuePanelCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Show or hide the queue panel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A0;" Margin="0,0,8,0" />
                                <TextBlock Text="Queue panel" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding UserDisplayText}" Style="{StaticResource MutedText}" Margin="4,6,0,4" />
                        <Button Content="Sign out" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <DockPanel Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,6" />
                        <ListBox x:Name="CategoryList" DataContext="{Binding Library}" ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnCategorySelected" AutomationProperties.Name="Categories">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TrackCount}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Centre content -->
            <ContentControl Grid.Column="1" x:Name="PageHost" Content="{Binding CurrentContent}" Margin="20,16,20,12" Focusable="False" />

            <!-- Right: collapsible queue panel -->
            <Border Grid.Column="2" Width="340" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0" Padding="12"
                    Visibility="{Binding IsQueuePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                Command="{Binding ToggleQueuePanelCommand}" ToolTip="Hide queue panel" AutomationProperties.Name="Hide queue panel" />
                        <TextBlock Text="Up next" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <views:QueueView DataContext="{Binding Queue}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom: now playing -->
        <views:NowPlayingBar Grid.Row="3" x:Name="NowPlayingBar" DataContext="{Binding NowPlaying}"
                             MiniPlayerRequested="OnMiniPlayerRequested"
                             Visibility="{Binding DataContext.IsSignedIn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
