<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SabhaMujic.Desktop.Converters">
    <!--
        SabhaMujic theme: one place for colours, sizes and control styles.
        Sized for use at an event: large text, large transport buttons, high contrast.
        Icons use the "Segoe MDL2 Assets" font that ships with Windows 10/11.
    -->

    <!-- Converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:PngBytesToImageConverter x:Key="PngToImage" />

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>

    <!-- Palette -->
    <Color x:Key="AccentColor">#C2410C</Color>
    <Color x:Key="AccentHoverColor">#9A3412</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEDD5" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EAECEF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="PlayerTextBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="PlayerMutedTextBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="PlayerButtonBrush" Color="#374151" />
    <SolidColorBrush x:Key="PlayerButtonHoverBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="CurrentItemBrush" Color="#FFEDD5" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#78350F" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534" />

    <!-- Text styles (keyed, so control templates are unaffected) -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small icon button for rows (remove, move up/down…). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Transport buttons in the now-playing bar: large and round. -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlayerButtonBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                        <Ellipse x:Name="FocusRing" Stroke="{StaticResource AccentSoftBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource PlayerButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="68" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Text-labelled button on the dark player bar (loop mode, mini player). -->
    <Style x:Key="PlayerTextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlayerButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlayerButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PlayerButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Navigation entries in the sidebar. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
                        <Grid>
                            <Border x:Name="Bar" Width="4" HorizontalAlignment="Left" Margin="-12,0,0,0" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- Lists -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            BorderBrush="{StaticResource HoverBrush}" BorderThickness="0,0,0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sliders on the dark player bar -->
    <Style x:Key="PlayerSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Message banners -->
    <Style x:Key="BannerBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource InfoTextBrush}" />
    </Style>
    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarningTextBrush}" />
    </Style>
    <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorTextBrush}" />
    </Style>

    <!-- Card surface for page sections -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <!--
        Shared error/status strip used at the top of every page. DataContext: a ViewModelBase
        (ErrorMessage, StatusMessage, DismissMessageCommand).
    -->
    <DataTemplate x:Key="MessageStrip">
        <StackPanel>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss message" Command="{Binding DismissMessageCommand}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss message" Command="{Binding DismissMessageCommand}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
