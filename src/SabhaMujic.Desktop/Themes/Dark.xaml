<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark theme tokens (docs/DESIGN.md). Light.xaml defines exactly the same keys; ThemeManager swaps the two at
        runtime, so every control refers to these brushes with DynamicResource. "…LineBrush" = the colour at ~45 %
        opacity (pill borders); "…SoftBrush" = the soft pill fill.
    -->
    <Color x:Key="BgColor">#11151A</Color>
    <Color x:Key="SurfaceColor">#171C22</Color>
    <Color x:Key="Surface2Color">#1E242C</Color>
    <Color x:Key="LineColor">#2A313A</Color>
    <Color x:Key="TextColor">#F2F4F6</Color>
    <Color x:Key="Text2Color">#9AA4AE</Color>
    <Color x:Key="Text3Color">#6B7580</Color>
    <Color x:Key="AccentColor">#4FB3A9</Color>
    <Color x:Key="AccentSoftColor">#173430</Color>
    <Color x:Key="BlueColor">#4C7BD9</Color>
    <Color x:Key="BlueSoftColor">#16233A</Color>
    <Color x:Key="VioletColor">#9B7BE0</Color>
    <Color x:Key="VioletSoftColor">#241E36</Color>
    <Color x:Key="AmberColor">#E0A54C</Color>
    <Color x:Key="AmberSoftColor">#33281A</Color>
    <Color x:Key="DangerColor">#E06A6A</Color>
    <Color x:Key="DangerSoftColor">#3A1F22</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="{StaticResource AccentColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="BlueSoftBrush" Color="{StaticResource BlueSoftColor}" />
    <SolidColorBrush x:Key="BlueLineBrush" Color="{StaticResource BlueColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="VioletSoftBrush" Color="{StaticResource VioletSoftColor}" />
    <SolidColorBrush x:Key="VioletLineBrush" Color="{StaticResource VioletColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="{StaticResource AmberSoftColor}" />
    <SolidColorBrush x:Key="AmberLineBrush" Color="{StaticResource AmberColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="DangerLineBrush" Color="{StaticResource DangerColor}" Opacity="0.45" />
    <!-- Text on a filled accent surface: the background colour (primary buttons, play circle). -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource BgColor}" />
    <!-- Text on a filled danger surface (close-button hover, confirm-delete). -->
    <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />
</ResourceDictionary>
