<UserControl x:Class="SabhaMujic.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels;assembly=SabhaMujic.Desktop.ViewModels">
    <UserControl.Resources>
        <!-- One menu instance per row (x:Shared=False); its DataContext is the row's TrackItemViewModel. -->
        <ContextMenu x:Key="TrackMenu" x:Shared="False">
            <MenuItem Header="Play now" Command="{Binding Owner.PlayNowCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" />
            <MenuItem Header="Play next" Command="{Binding Owner.PlayNextCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="Add to queue" Command="{Binding Owner.AddToQueueCommand}" CommandParameter="{Binding}" />
            <Separator />
            <!-- Sub-items are the playlists; their Click bubbles to OnAddToPlaylistClick (code-behind). -->
            <MenuItem Header="Add to playlist" ItemsSource="{Binding Owner.PlaylistTargets}" Click="OnAddToPlaylistClick">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + search -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Grid DockPanel.Dock="Right" Width="300">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,5,34,5"
                         AutomationProperties.Name="Search tracks" ToolTip="Search titles and artists (Ctrl+F)">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="10,0,0,0" HorizontalAlignment="Left"
                           Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Search…" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource DisabledTextBrush}"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,2,0"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear search" AutomationProperties.Name="Clear search"
                        Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}" />
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Library" Style="{StaticResource PageTitle}" Margin="0" />
                <TextBlock Text="{Binding SelectedCategory.Name, StringFormat=' · {0}'}" FontSize="24" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />

        <!-- Track list -->
        <ListBox Grid.Row="2" x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                 MouseDoubleClick="OnTrackDoubleClick" AutomationProperties.Name="Tracks">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="ContextMenu" Value="{StaticResource TrackMenu}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TrackItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource MutedText}"
                                       Visibility="{Binding Artist, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButton}" Content="Play" Padding="12,4" MinHeight="32"
                                    Command="{Binding Owner.PlayNowCommand}" CommandParameter="{Binding}"
                                    ToolTip="Play now" AutomationProperties.Name="Play now" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="Play next"
                                    Command="{Binding Owner.PlayNextCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Play next" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add to queue"
                                    Command="{Binding Owner.AddToQueueCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Add to queue" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="No tracks match." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />

        <!-- Paging -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousPageCommand}"
                    ToolTip="Previous page" AutomationProperties.Name="Previous page" />
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0" />
            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextPageCommand}"
                    ToolTip="Next page" AutomationProperties.Name="Next page" />
        </StackPanel>
    </Grid>
</UserControl>
