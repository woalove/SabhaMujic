<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Cross-platform tests everywhere; on Windows also a net10.0-windows run that covers Media Foundation and WASAPI.
      `-p:AudioWindowsTests=true` compiles (but cannot run) the Windows target on Linux.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(AudioWindowsTests)' == 'true'">net10.0;net10.0-windows</TargetFrameworks>
    <!--
      The render-path allocation tests measure with GC.GetAllocatedBytesForCurrentThread. While a *background* GC starts,
      the measuring thread's allocation context is retired and its unused tail (< one 8 KB allocation quantum) is
      reported as allocated, even for code that allocates nothing (seen on CI run 30: 7888 B; reproduced locally with an
      allocation-free loop while another thread allocates). Blocking GCs do not do this, so this test process runs
      without concurrent GC. RenderPathTests asserts the setting is in effect.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SabhaMujic.Audio/SabhaMujic.Audio.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="../../src/SabhaMujic.Audio.Windows/SabhaMujic.Audio.Windows.csproj" />
  </ItemGroup>
</Project>
