<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell: views, styles and thin Windows adapters only. All view-model logic lives in
       SabhaMujic.Desktop.ViewModels (net10.0) so it can be unit-tested on Linux. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Exe/taskbar/shortcut icon; generated by tools/icon/generate_icon.py (16, 32, 48, 256 px). -->
    <ApplicationIcon>Assets\SabhaMujic.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also a WPF resource, so windows can use it as their title-bar icon (pack://application:,,,/Assets/SabhaMujic.ico). -->
    <Resource Include="Assets\SabhaMujic.ico" />
    <!-- Inter 4.1 (SIL Open Font License 1.1), embedded so the app looks the same on every PC and works offline.
         Referenced as ../Assets/Fonts/#Inter from Themes/Controls.xaml. The licence ships next to the exe. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\LICENSE.txt" Link="Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SabhaMujic.Client/SabhaMujic.Client.csproj" />
    <ProjectReference Include="../SabhaMujic.Desktop.ViewModels/SabhaMujic.Desktop.ViewModels.csproj" />
    <!-- Used by the named-pipe client that M3 adds. -->
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
</Project>
