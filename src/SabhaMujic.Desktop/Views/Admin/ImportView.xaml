<UserControl x:Class="SabhaMujic.Desktop.Views.Admin.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels.Admin;assembly=SabhaMujic.Desktop.ViewModels">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Add files…" Command="{Binding AddFilesCommand}" Margin="0,0,8,6" />
            <Button Content="Start import" Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" Margin="0,0,8,6" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
            <Button Content="Clear finished" Command="{Binding ClearFinishedCommand}" Margin="0,0,16,6" />
            <TextBlock Text="Category for new files:" VerticalAlignment="Center" Margin="0,0,6,6" />
            <ComboBox Width="180" Margin="0,0,0,6" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding DefaultCategory}"
                      DisplayMemberPath="Name" AutomationProperties.Name="Category for new files" />
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Uploading…" Style="{StaticResource MutedText}" />
            <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" Height="10" />
        </StackPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />
        <TextBlock DockPanel.Dock="Bottom" FontSize="12" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Supported: MP3, WAV, M4A, AAC, FLAC, WMA, up to 1 GB each. Files are uploaded to the SabhaMujic service and stored where volunteers can't copy them." />

        <ListBox ItemsSource="{Binding Files}" AutomationProperties.Name="Files to import">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ImportFileViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="140" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                <Run Text="{Binding SizeText, Mode=OneWay}" /> · <Run Text="{Binding StatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}"
                                 Margin="0,0,6,0" ToolTip="Title" AutomationProperties.Name="Title" />
                        <TextBox Grid.Column="2" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}"
                                 Margin="0,0,6,0" ToolTip="Artist (optional)" AutomationProperties.Name="Artist" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Owner.CategoryOptions}" SelectedItem="{Binding Category}"
                                  DisplayMemberPath="Name" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Category" />
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove from list"
                                Command="{Binding Owner.RemoveFileCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Remove from list" />

                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,6,0" Maximum="100"
                                     Value="{Binding Percent, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
