<UserControl x:Class="SabhaMujic.Desktop.Views.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SabhaMujic.Desktop.ViewModels;assembly=SabhaMujic.Desktop.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="New playlist" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Margin="0" />
            <TextBlock Text="Playlists" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <ContentControl Grid.Row="1" Grid.ColumnSpan="3" Content="{Binding}" ContentTemplate="{StaticResource MessageStrip}" Focusable="False" />

        <!-- Playlist list -->
        <ListBox Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                 AutomationProperties.Name="Playlists">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlaylistItemViewModel}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Selected playlist -->
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Choose a playlist on the left, or create a new one." Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        <DockPanel Grid.Row="2" Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPlaylist.Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Content="Add to queue" Style="{StaticResource PrimaryButton}" Command="{Binding EnqueueAppendCommand}" Margin="0,0,8,6" />
                <Button Content="Replace queue" Command="{Binding EnqueueReplaceCommand}" Margin="0,0,8,6" />
                <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,0,8,6" />
                <Button Content="Delete" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Drag to reorder. Add tracks from the Library (right-click a track → Add to playlist)."
                       FontSize="12" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            <ListBox x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" AutomationProperties.Name="Playlist tracks">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlaylistTrackViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Style="{StaticResource MutedText}" FontSize="12"
                                           Visibility="{Binding Artist, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up" AutomationProperties.Name="Move up"
                                        Command="{Binding Owner.MoveTrackUpCommand}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down" AutomationProperties.Name="Move down"
                                        Command="{Binding Owner.MoveTrackDownCommand}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from playlist" AutomationProperties.Name="Remove from playlist"
                                        Command="{Binding Owner.RemoveTrackCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
